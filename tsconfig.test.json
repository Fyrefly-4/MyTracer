{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["node", "electron"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/main/appearance.ts",
    "src/main/windows-transparency.ts",
    "src/main/appearance-ipc.ts",
    "src/main/ipc-security.ts",
    "src/application/**/*.ts",
    "src/contracts/**/*.ts",
    "src/domain/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/app/ui-session.ts",
    "src/renderer/src/app/routine-edit-session.ts",
    "src/renderer/src/app/selection-preferences.ts",
    "src/renderer/src/app/navigation.ts",
    "src/renderer/src/features/home/calendar.ts",
    "src/renderer/src/features/review/review-reference.ts",
    "src/renderer/src/features/goals/goal-cover.ts",
    "src/renderer/src/features/home/home-model.ts",
    "src/renderer/src/app/ui-text.ts"
  ]
