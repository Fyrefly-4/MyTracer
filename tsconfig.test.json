{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "electron"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/main/appearance.ts",
    "src/main/thoughts-ipc.ts",
    "src/main/booklets-ipc.ts",
    "src/preload/pending-close-request.ts",
    "src/main/record-continuity.ts",
    "src/main/record-drafts-ipc.ts",
    "src/main/records-ipc.ts",
    "src/main/action-recording-contexts.ts",
    "src/main/routine-recording-contexts.ts",
